      - "\u4E0B\u8F09\u7D50\u675F"
      - "\uB2E4\uC6B4\uB85C\uB4DC \uC644\uB8CC"
      - "\u30C0\u30A6\u30F3\u30ED\u30FC\u30C9\u5B8C\u4E86"
      - "T\xE9l\xE9chargement complet"
      - Download abgeschlossen
      - "\u0417\u0430\u0433\u0440\u0443\u0437\u043A\u0430 \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043D\u0430"
