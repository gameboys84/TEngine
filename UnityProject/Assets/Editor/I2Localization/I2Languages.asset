      - "\u8D44\u6E90\u7248\u672C\u53F7:{0}"
      - "\u8CC7\u6E90\u7248\u672C\u865F:{0}"
      - "\uB9AC\uC18C\uC2A4 \uBC84\uC804 \uBC88\uD638: {0}"
      - "\u30EA\u30BD\u30FC\u30B9\u306E\u30D0\u30FC\u30B8\u30E7\u30F3\u756A\u53F7:
        {0}"
      - "Num\xE9ro de version de la ressource\_: {0}"
      - 'Ressourcenversionsnummer: {0}'
      - "\u041D\u043E\u043C\u0435\u0440 \u0432\u0435\u0440\u0441\u0438\u0438 \u0440\u0435\u0441\u0443\u0440\u0441\u0430:
        {0}"
      - "N\xFAmero de versi\xF3n del recurso: {0}"
      - "N\xFAmero da vers\xE3o do recurso: {0}"
      - 'Numero di versione della risorsa: {0}'
      - 'Versienummer van de bron: {0}'
      - "Kaynak s\xFCr\xFCm numaras\u0131: {0}"
      - 'Nomor versi sumber daya: {0}'
      - 'Numer wersji zasobu: {0}'
      - "\u0E2B\u0E21\u0E32\u0E22\u0E40\u0E25\u0E02\u0E40\u0E27\u0E2D\u0E23\u0E4C\u0E0A\u0E31\u0E19\u0E02\u0E2D\u0E07\u0E17\u0E23\u0E31\u0E1E\u0E22\u0E32\u0E01\u0E23:
        {0}"
